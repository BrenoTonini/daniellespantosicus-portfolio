---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    title: string;
    description: string;
    lang: string;
    canonicalURL?: string;
    ogImage?: ImageMetadata;
    alternates?: { lang: string; href: string }[];
    noindex?: boolean;
}

const { title, description, lang, canonicalURL, ogImage, alternates, noindex } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead
            title={title}
            description={description}
            lang={lang}
            canonicalURL={canonicalURL}
            image={ogImage}
            alternates={alternates}
            noindex={noindex}
        />
    </head>

    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>