---
import VGenLogo from '../assets/icons/vgen-logo-outline.svg';
import InstagramLogo from '../assets/icons/instagram-logo-outline.svg';
import XLogo from '../assets/icons/x-logo-outline.svg';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { COMMISSION_URL, INSTAGRAM_URL, X_URL } from '../lib/links';

interface Props {
    class?: string;
}

const { class: className = '' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
    { href: COMMISSION_URL, icon: VGenLogo.src, key: 'socials.vgen' },
    { href: INSTAGRAM_URL, icon: InstagramLogo.src, key: 'socials.instagram' },
    { href: X_URL, icon: XLogo.src, key: 'socials.x' },
] as const;
---

<ul class={`social-links ${className}`} aria-label={t('socials.ariaLabel')}>
    {socials.map(({ href, icon, key }) => (
        <li>
            <a href={href} target="_blank" rel="noopener noreferrer" class="social-link">
                <span class="sr-only">{t(key)}</span>
                <span
                    class="social-icon"
                    style={`mask-image: url(${icon}); -webkit-mask-image: url(${icon});`}
                    aria-hidden="true"
                ></span>
            </a>
        </li>
    ))}
</ul>

<style>
    .social-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .social-icon {
        display: inline-block;
        width: 24px;
        height: 24px;
        background-color: var(--color-muted);
        mask-repeat: no-repeat;
        mask-position: center;
        mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: center;
        -webkit-mask-size: contain;
        transition: background-color 150ms ease, transform 150ms ease;
    }

    .social-link {
        opacity: 0.7;
        display: inline-flex;
        position: relative;
        transition: opacity 150ms ease;
    }

    /* O ícone tem 24px — exatamente o mínimo do WCAG 2.5.8, sem folga. O alvo
       cresce para 32px por pseudo-elemento, e não por padding, porque o header
       em 390px não tem os ~40px extras que o padding custaria: a área de toque
       aumenta sem que o layout mude. O recuo é metade do `gap`, então os alvos
       vizinhos se encostam sem se sobrepor. */
    .social-link::after {
        content: '';
        position: absolute;
        inset: -0.25rem;
    }

    .social-link:hover,
    .social-link:focus-visible {
        opacity: 1;
    }

    .social-link:hover .social-icon,
    .social-link:focus-visible .social-icon {
        background-color: var(--color-primary);
        transform: translateY(-1px);
    }
</style>
