---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/danielle-spantosicus-banner.webp";

interface Props {
	title: string;
	description: string;
	lang?: string;
	canonicalURL?: string;
	image?: ImageMetadata;
	alternates?: { lang: string; href: string }[];
	/** Tira a página do índice e suprime canonical/hreflang. Para rotas que não
	  * representam um endereço válido — hoje só a 404. */
	noindex?: boolean;
}

const {
	title,
	description,
	lang = "pt-br",
	canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
	image = FallbackImage,
	alternates = [],
	noindex = false,
} = Astro.props;

/** og:locale no formato do Open Graph (idioma_TERRITÓRIO). É um mapa, e não um
  * ternário: com três idiomas, o ternário servia `en_US` para o espanhol. */
const OG_LOCALE: Record<string, string> = {
	en: "en_US",
	"pt-br": "pt_BR",
	es: "es_ES",
};
const ogLocale = OG_LOCALE[lang] ?? "en_US";
const ogImage = new URL(image.src, Astro.url);
const xDefaultHref =
	alternates.find((a) => a.lang === "en")?.href ?? canonicalURL;
---

<!-- Essentials -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap"
	rel="stylesheet"
/>

<!-- Canonical & hreflang -->
{
	noindex ? (
		<meta name="robots" content="noindex, follow" />
	) : (
		<link rel="canonical" href={canonicalURL} />
	)
}
{
	alternates.map(({ lang: l, href }) => (
		<link rel="alternate" hreflang={l} href={href} />
	))
}
{
	alternates.length > 0 && (
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
	)
}

<!-- Primary Meta -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
