---
import type { HomeContent } from '../../i18n/home';
import SectionHeading from './SectionHeading.astro';
import { Image } from 'astro:assets';

interface Props {
  content: HomeContent['process'];
}

const { content } = Astro.props;

/** Sem as marcas de corte o ícone flutua num retângulo vazio, que é lido como
  * imagem que falhou ao carregar. */
const CROP_MARKS = [
  'top-2 left-2 border-t border-l',
  'top-2 right-2 border-t border-r',
  'bottom-2 left-2 border-b border-l',
  'bottom-2 right-2 border-b border-r',
] as const;

/** Tem que acompanhar as classes `w-*` da prancha, senão o browser baixa a
  * candidata errada do srcset. No grid,
  * `prancha = min(1280, 100vw − 128) / 5 − 16` — satura em 240px a partir de
  * 1408px de viewport, não de 1280: o `px-16` da seção adianta a saturação.
  * Conferido no navegador em 390/640/768/1024/1200/1408. */
const PLATE_SIZES = [
  '(min-width: 1408px) 240px',
  '(min-width: 1024px) calc(20vw - 41.6px)',
  '(min-width: 768px) 160px',
  '(min-width: 640px) 128px',
  '96px',
].join(', ');
---

<section class="py-24 lg:py-32 px-6 sm:px-10 lg:px-16" aria-labelledby="process-heading">
  <div class="max-w-7xl mx-auto">

    <SectionHeading
      headingId="process-heading"
      eyebrow={content.eyebrow}
      heading={content.heading}
      body={content.body}
      class="mb-10 lg:mb-20"
    />

    <ol class="process-list lg:grid lg:grid-cols-5" role="list">
      {content.steps.map((step) => (
        <li class="group flex flex-row items-center gap-5 py-7 md:gap-8 md:py-9 lg:flex-col lg:items-stretch lg:gap-0 lg:py-0 lg:px-2">

          {/* A moldura constante é o que faz a fileira ser lida como uma peça se
              formando, e não como cinco imagens diferentes. */}
          <div
            class="relative shrink-0 w-24 sm:w-32 md:w-40 lg:w-full aspect-4/5 overflow-hidden bg-(--color-surface) border border-(--color-primary-pale) transition-colors duration-500 group-hover:border-(--color-primary)"
          >
            {step.image && step.imageAlt ? (
              <Image
                src={step.image}
                alt={step.imageAlt}
                widths={[128, 320, 480]}
                sizes={PLATE_SIZES}
                loading="lazy"
                decoding="async"
                class="block w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.04]"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                {CROP_MARKS.map((position) => (
                  <span class={`absolute w-3 h-3 lg:w-4 lg:h-4 border-(--color-primary-pale) ${position}`}></span>
                ))}

                {/* Travado em 2px pelo `non-scaling-stroke` do `<style>` — o
                    dobro das réguas da seção. Sem isso o traço escalaria com o
                    SVG: 3px na miniatura mobile, 5.3px na prancha de desktop. */}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  xmlns="http://www.w3.org/2000/svg"
                  class="plate-icon w-9 h-9 md:w-14 md:h-14 lg:w-16 lg:h-16 text-(--color-primary) transition-colors duration-500 group-hover:text-(--color-foreground)"
                >
                  <Fragment set:html={step.icon} />
                </svg>
              </div>
            )}

            <div class="grain-overlay"></div>
          </div>

          <div class="min-w-0 md:max-w-2xl lg:max-w-none lg:text-center">
            {/* O `-mx-2` anula o `lg:px-2` do `li`: é o que faz as réguas de
                colunas vizinhas se encostarem numa linha do tempo contínua. O
                número é `aria-hidden` porque a ordem já vem do `<ol>`. */}
            <div class="hidden lg:flex items-center gap-3 -mx-2 my-5" aria-hidden="true">
              <span class="h-px flex-1 bg-(--color-primary-pale)"></span>
              <span class="font-display text-lg leading-none text-(--color-primary)">{step.number}</span>
              <span class="h-px flex-1 bg-(--color-primary-pale)"></span>
            </div>

            <h3 class="font-sans font-medium text-sm md:text-base lg:text-sm text-(--color-foreground) tracking-wide">
              <span class="font-display text-base md:text-lg lg:hidden text-(--color-primary) mr-2" aria-hidden="true">
                {step.number}
              </span>
              {step.title}
            </h3>

            <p class="mt-1.5 md:mt-2.5 lg:mt-2 text-sm md:text-base lg:text-sm text-(--color-foreground-muted) leading-relaxed font-sans">
              {step.description}
            </p>
          </div>

        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  /* Divisória da pilha mobile — no grid o papel passa para a linha do tempo sob
     cada prancha. Em CSS e não em `border-t lg:border-0`: as duas classes
     disputam a mesma propriedade, e a ordem de saída do Tailwind entre variante
     de pseudo-classe e media query não é algo em que valha apostar. */
  .process-list > li + li {
    border-top: 1px solid var(--color-primary-pale);
  }

  @media (min-width: 1024px) {
    .process-list > li + li {
      border-top: 0;
    }
  }

  /* `vector-effect` não é herdado, então precisa cair no `path` — e os `path`
     vêm de `set:html`, que o Astro não marca com `data-astro-cid-*`. Sem o
     `:global()` o seletor escopado não encontraria nada. */
  .plate-icon :global(path) {
    vector-effect: non-scaling-stroke;
  }
</style>
