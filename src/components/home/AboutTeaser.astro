---
import type { HomeContent } from '../../i18n/home';
import { Image } from 'astro:assets';

interface Props {
  content: HomeContent['about'];
}

const { content } = Astro.props;
---

<section
  class="about-parallax relative py-24 lg:py-32 px-6 sm:px-10 lg:px-16 bg-(--color-sparkle) overflow-hidden"
  aria-labelledby="about-teaser-heading"
>
  <figure class="absolute inset-0 pointer-events-none m-0" aria-hidden="true">
    <Image
      id="about-parallax-img"
      class="about-parallax-img absolute left-0 w-full object-cover object-center"
      src={content.parallaxImage}
      alt={content.imageAlt}
      widths={[1200, 1800, 2400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <div class="about-parallax-vignette absolute inset-0" aria-hidden="true"></div>
  </figure>

  <div class="grain-overlay" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto flex justify-center">
    <div class="about-parallax-card w-full max-w-xl flex flex-col gap-8 px-8 py-10 sm:px-12 sm:py-14">
      <span class="text-xs tracking-[0.25em] uppercase text-(--color-primary) font-sans font-medium">
        {content.eyebrow}
      </span>

      <h2
        id="about-teaser-heading"
        class="font-display text-4xl md:text-5xl font-normal leading-[1.1] text-(--color-foreground)"
      >
        {content.heading}
      </h2>

      <p class="text-base leading-relaxed font-sans text-(--color-foreground-muted)">
        {content.body}
      </p>

      <a
        href={content.ctaHref}
        class="self-start inline-flex items-center gap-2 text-sm font-sans font-medium text-(--color-foreground) border-b border-(--color-foreground-muted) pb-0.5 hover:text-(--color-primary) hover:border-(--color-primary) transition-colors duration-300"
      >
        {content.cta}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* `--pan` é derivado de `--overscan`, não escolhido: `translateY` em % é
     relativo à altura da PRÓPRIA imagem, então o limite sem faixa vazia na
     borda é overscan / (1 + 2*overscan) — com 20% de sobra, 14.2%. */
  .about-parallax {
    --overscan: 20%;
    --pan: 14%;
    view-timeline-name: --about-parallax;
    view-timeline-axis: block;
  }

  .about-parallax-img {
    top: calc(-1 * var(--overscan));
    height: calc(100% + 2 * var(--overscan));
    opacity: 0.3;
  }

  .about-parallax-vignette {
    background: radial-gradient(
      ellipse 115% 75% at 50% 50%,
      transparent 25%,
      var(--color-sparkle) 100%
    );
  }

  /* Não usar `backdrop-filter` aqui: refaz o blur a cada frame enquanto a
     imagem atrás se move, e o quase-opaco dá o mesmo contraste de leitura. */
  .about-parallax-card {
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
  }

  /* Valores literais de propósito: um transform que depende de `var()` pode
     tirar a animação do compositor. Devem acompanhar `--pan` acima. */
  @keyframes about-parallax-pan {
    from {
      transform: translate3d(0, -14%, 0);
    }
    to {
      transform: translate3d(0, 14%, 0);
    }
  }

  /* O timeline é nomeado na seção, e não `view()` na imagem, porque a seção é
     `overflow: hidden` — logo, um scroll container. Um `view()` na imagem
     resolveria o scrollport para a seção, que não rola, e a animação ficaria
     travada no primeiro frame. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about-parallax-img {
        animation: about-parallax-pan linear both;
        animation-timeline: --about-parallax;
        animation-range: cover 0% cover 100%;
      }
    }
  }
</style>

<script>
  // Fallback para navegadores sem scroll-driven animations.
  if (!CSS.supports('animation-timeline', 'view()')) {
    const img = document.getElementById('about-parallax-img');
    const section = img?.closest('section');

    if (img && section) {
      // Mesmo limite de `--pan` no <style>.
      const PAN = 14;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      let visible = false;
      let frame = 0;

      const paint = () => {
        frame = 0;
        const rect = section.getBoundingClientRect();
        const travel = window.innerHeight + rect.height;
        const raw = travel > 0 ? 1 - rect.bottom / travel : 0;
        const progress = Math.min(1, Math.max(0, raw));
        img.style.transform = `translate3d(0, ${(progress - 0.5) * 2 * PAN}%, 0)`;
      };

      // Um write por frame: sem o rAF, cada evento de scroll intercalaria uma
      // leitura de layout com uma escrita de estilo.
      const schedule = () => {
        if (!visible || reduce.matches || frame) return;
        frame = requestAnimationFrame(paint);
      };

      // `will-change` só enquanto a seção está em tela — permanente custa
      // memória de GPU à toa.
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        img.style.willChange = visible ? 'transform' : '';
        schedule();
      }).observe(section);

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });

      reduce.addEventListener('change', () => {
        if (reduce.matches) img.style.transform = '';
        else schedule();
      });
    }
  }
</script>
