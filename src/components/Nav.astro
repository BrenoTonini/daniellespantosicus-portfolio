---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
    ariaLabel: string;
    class?: string;
}

const { ariaLabel, class: className = '' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatedPath = useTranslatedPath(lang);

const pathname = Astro.url.pathname;

const links = [
    { key: 'nav.home', href: translatedPath('/') },
    { key: 'nav.about', href: translatedPath('/about') },
    { key: 'nav.portfolio', href: translatedPath('/portfolio') },
] as const;

const isActive = (href: string) =>
    pathname === href || pathname === `${href}/` || `${pathname}/` === href;
---

<nav aria-label={ariaLabel} class={`relative z-10 flex items-center gap-1 ${className}`}>
    {links.map(({ key, href }) => (
        <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="nav-link flex items-center px-3 py-3 text-sm font-medium no-underline transition-colors"
        >
            <span class="nav-label">{t(key)}</span>
        </a>
    ))}
</nav>

<style>
    .nav-link {
        color: var(--color-muted);
    }

    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link[aria-current='page'] {
        color: var(--color-foreground);
    }

    /* O sublinhado é ancorado no rótulo, não no <a>: assim o padding do link
       continua dando 44px de área de toque sem afastar a barrinha da palavra. */
    .nav-label {
        position: relative;
        display: inline-block;
    }

    .nav-label::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.375rem;
        height: 2px;
        background-color: var(--color-primary);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-link:hover .nav-label::after,
    .nav-link:focus-visible .nav-label::after {
        background-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
        transform: scaleX(1);
    }

    .nav-link[aria-current='page'] .nav-label::after {
        background-color: var(--color-primary);
        transform: scaleX(1);
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-label::after {
            transition: none;
        }
    }
</style>
