---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import Nav from './Nav.astro';
import LanguagePicker from './LanguagePicker.astro';
import SocialLinks from './SocialLinks.astro';
import Assinatura from '../assets/assinatura-danielle-spantosicus-branca.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatedPath = useTranslatedPath(lang);
---

<header class="sticky top-0 z-50 bg-(--color-surface) shadow-sm overflow-visible">

    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">

        <a href={translatedPath('/')} class="shrink-0 self-stretch flex items-center" aria-label={t('header.home.ariaLabel')}>
            <Image
                src={Assinatura}
                alt="Danielle Spantosicus"
                class="signature-img h-16 w-auto relative z-10"
                widths={[200, 400]}
                sizes="(max-width: 640px) 160px, 100px"
                loading="eager"
                format="webp"
            />
        </a>

        <Nav ariaLabel={t('nav.ariaLabel')} class="hidden sm:flex flex-1 justify-center" />

        <div class="flex items-center gap-3 shrink-0">
            <SocialLinks />
            <LanguagePicker />
        </div>
    </div>

    <div class="sm:hidden border-t border-(--color-border)">
        <div class="px-4 h-12 flex items-center justify-center">
            <Nav ariaLabel={t('nav.ariaLabel.mobile')} />
        </div>
    </div>

</header>

<style>
    .signature-img {
        height: 4.5rem;
        margin-top: 1rem;
        width: auto;
        position: relative;
        z-index: 10;
    }
</style>
