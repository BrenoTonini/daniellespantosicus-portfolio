---
import type { NotFoundContent } from '../../i18n/notFound';

interface Props {
  content: NotFoundContent;
}

const { content } = Astro.props;

/** Mesmas marcas de corte de Process.astro — é o vocabulário de prancha do
  * site, e sem elas os dígitos flutuam num retângulo vazio. */
const CROP_MARKS = [
  'top-2 left-2 border-t border-l',
  'top-2 right-2 border-t border-r',
  'bottom-2 left-2 border-b border-l',
  'bottom-2 right-2 border-b border-r',
] as const;
---

<section
  class="notfound relative min-h-[calc(100svh-8rem)] overflow-hidden flex items-center"
  aria-labelledby="notfound-heading"
  data-notfound
>
  <div class="nf-light" aria-hidden="true"></div>
  <div class="grain-overlay" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-14 sm:py-24 lg:py-32">
    {/* Os espaçamentos do mobile são mais apertados que os do resto do site de
       propósito: numa 404 o caminho de volta tem que caber na primeira tela. */}
    <div class="w-full grid lg:grid-cols-[1fr_auto] gap-10 sm:gap-16 lg:gap-24 items-center">

      <div class="flex flex-col gap-5 sm:gap-8">
        <span class="text-xs tracking-[0.25em] uppercase text-(--color-primary) font-sans font-medium">
          {content.eyebrow}
        </span>

        <h1
          id="notfound-heading"
          class="font-display text-4xl sm:text-5xl lg:text-6xl text-(--color-foreground) leading-[1.05] font-normal"
        >
          {content.heading}
        </h1>

        <p class="text-base sm:text-lg text-(--color-foreground-muted) leading-relaxed font-sans max-w-lg">
          {content.body}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-2">
          {/* Passar o ponteiro no caminho de volta acerta o registro da
              prancha: o botão que resolve o erro é o que conserta a imagem. */}
          <a
            href={content.ctaPrimaryHref}
            data-notfound-home
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-(--color-foreground) text-(--color-background) text-sm font-sans font-medium tracking-wide hover:bg-(--color-primary-dark) transition-colors duration-300"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13 8H3M7 12L3 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {content.ctaPrimary}
          </a>
          <a
            href={content.ctaSecondaryHref}
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border border-(--color-foreground) text-(--color-foreground) text-sm font-sans font-medium tracking-wide hover:bg-(--color-foreground) hover:text-(--color-background) transition-colors duration-300"
          >
            {content.ctaSecondary}
          </a>
        </div>
      </div>

      {/* Decorativa por inteiro: os dígitos e a legenda só repetem, em imagem,
          o que o `h1` já diz.

          É uma prancha retrato como as de Process.astro, então a largura tem
          que ser contida no mobile — em largura cheia ela empurraria o caminho
          de volta para fora da primeira tela. */}
      <figure
        class="nf-plate order-first lg:order-none relative shrink-0 w-full max-w-[13rem] sm:max-w-xs lg:w-96 xl:w-105"
        aria-hidden="true"
      >
        <div class="nf-frame absolute -top-4 -right-4 w-full h-full border border-(--color-primary-pale)"></div>

        <div class="relative bg-(--color-surface) border border-(--color-primary-pale) aspect-4/5 flex items-center justify-center overflow-hidden">
          {CROP_MARKS.map((position) => (
            <span class={`absolute w-3 h-3 lg:w-4 lg:h-4 border-(--color-primary-pale) ${position}`}></span>
          ))}

          {/* Três cópias fora de registro, como uma tiragem que saiu torta. Só
              a de cima é opaca; as outras duas são as chapas de cor. */}
          <div class="nf-stack relative font-display leading-none text-[4.25rem] sm:text-[6.5rem] lg:text-[7.5rem]">
            <span class="nf-ghost nf-ghost-a" data-notfound-ghost="-1">{content.code}</span>
            <span class="nf-ghost nf-ghost-b" data-notfound-ghost="1">{content.code}</span>
            <span class="nf-code">{content.code}</span>
          </div>

          <div class="grain-overlay"></div>
        </div>

        <figcaption class="mt-4 text-[10px] tracking-[0.2em] uppercase font-sans text-(--color-muted-soft)">
          {content.plateCaption}
        </figcaption>
      </figure>

    </div>
  </div>
</section>

<style>
  /* Mesmos gradientes estáticos do Hero, espelhados: brilho sem filtro de blur
     sobre superfícies de meia viewport. */
  .nf-light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        55% 50% at 10% 4%,
        color-mix(in srgb, var(--color-sparkle) 85%, transparent) 0%,
        transparent 72%
      ),
      radial-gradient(
        40% 36% at 96% 96%,
        color-mix(in srgb, var(--color-primary-pale) 60%, transparent) 0%,
        transparent 70%
      );
  }

  /* As cópias se sobrepõem à de cima, que é quem dá a caixa ao empilhamento. */
  .nf-ghost {
    position: absolute;
    inset: 0;
    /* `translate` (a propriedade própria, não a função) guarda o
       desalinhamento de base — assim o script escreve `transform` sem apagá-lo,
       e as duas composições se somam. */
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      translate 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 500ms ease;
    will-change: transform;
  }

  .nf-ghost-a {
    translate: -0.06em 0.03em;
    color: var(--color-primary-dark);
    animation: nf-drift-a 7s ease-in-out infinite alternate;
  }

  .nf-ghost-b {
    translate: 0.05em -0.035em;
    color: var(--color-primary);
    opacity: 0.35;
    animation: nf-drift-b 9s ease-in-out infinite alternate;
  }

  .nf-code {
    position: relative;
    color: var(--color-foreground);
  }

  /* Deriva de repouso — é o que faz a prancha respirar no toque, onde não há
     ponteiro para reagir. Só `transform`, resolvido no compositor. */
  @keyframes nf-drift-a {
    from {
      transform: translate3d(-0.02em, 0.015em, 0);
    }
    to {
      transform: translate3d(0.03em, -0.02em, 0);
    }
  }

  @keyframes nf-drift-b {
    from {
      transform: translate3d(0.025em, -0.02em, 0);
    }
    to {
      transform: translate3d(-0.03em, 0.02em, 0);
    }
  }

  /* Com o ponteiro na seção quem manda é o script, então a deriva sai de cena:
     dois movimentos na mesma propriedade não somam, um vence. */
  .notfound.is-live .nf-ghost {
    animation: none;
  }

  /* O registro acertando — as chapas voltam ao lugar e o 404 fica limpo. */
  .notfound.is-aligned .nf-ghost {
    animation: none;
    transform: none;
    translate: 0 0;
    opacity: 0.12;
  }

  .nf-frame {
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-plate:hover .nf-frame {
      transform: translate(0.5rem, -0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-ghost,
    .nf-frame {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-notfound]');
  const ghosts = [...document.querySelectorAll<HTMLElement>('[data-notfound-ghost]')];
  const home = document.querySelector<HTMLElement>('[data-notfound-home]');

  if (section && ghosts.length) {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    /** Deslocamento máximo de cada chapa, em px, nas pontas da seção. */
    const AMPLITUDE = 14;

    let frame = 0;
    let clientX = 0;
    let clientY = 0;

    // Mesma disciplina do Hero: `pointermove` dispara na taxa de polling do
    // mouse, então o rect é lido no máximo uma vez por frame — nunca no
    // handler — e invalidado por resize/scroll.
    let rect: DOMRect | null = null;
    const invalidate = () => {
      rect = null;
    };
    window.addEventListener('resize', invalidate, { passive: true });
    window.addEventListener('scroll', invalidate, { passive: true });

    const apply = () => {
      frame = 0;
      // Enquanto o registro está acertado o script não escreve nada: quem manda
      // é a regra de `.is-aligned`.
      if (section.classList.contains('is-aligned')) return;
      if (!rect) rect = section.getBoundingClientRect();

      // -1..1 a partir do centro da seção.
      const x = ((clientX - rect.left) / rect.width) * 2 - 1;
      const y = ((clientY - rect.top) / rect.height) * 2 - 1;

      for (const ghost of ghosts) {
        // As duas chapas puxam para lados opostos — é isso que abre e fecha o
        // desalinhamento conforme o ponteiro atravessa a seção.
        const dir = Number(ghost.dataset.notfoundGhost) || 1;
        const dx = (x * AMPLITUDE * dir).toFixed(2);
        const dy = (y * AMPLITUDE * dir).toFixed(2);
        ghost.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
      }
    };

    const track = (event: PointerEvent) => {
      if (!fine.matches || still.matches) return;
      clientX = event.clientX;
      clientY = event.clientY;
      if (!frame) frame = requestAnimationFrame(apply);
    };

    section.addEventListener('pointerenter', (event) => {
      if (!fine.matches || still.matches) return;
      section.classList.add('is-live');
      track(event);
    });

    section.addEventListener('pointerleave', () => {
      section.classList.remove('is-live');
      // Devolve as chapas ao desalinhamento de base, senão elas congelam onde o
      // ponteiro saiu.
      for (const ghost of ghosts) ghost.style.transform = '';
    });

    section.addEventListener('pointermove', track, { passive: true });

    fine.addEventListener('change', () => {
      if (!fine.matches) section.classList.remove('is-live');
    });

    // O caminho de volta conserta a impressão. Vale no foco também, para quem
    // navega por teclado ver a mesma resposta.
    if (home) {
      const setAligned = (on: boolean) => {
        section.classList.toggle('is-aligned', on);
        // As regras de `.is-aligned` são de folha de estilo, e estilo inline
        // ganha delas — daí a limpeza antes de entregar o controle ao CSS.
        if (on) for (const ghost of ghosts) ghost.style.transform = '';
      };

      home.addEventListener('pointerenter', () => setAligned(true));
      home.addEventListener('pointerleave', () => setAligned(false));
      home.addEventListener('focus', () => setAligned(true));
      home.addEventListener('blur', () => setAligned(false));
    }
  }
</script>
